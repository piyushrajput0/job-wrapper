# Unlocks resume tailoring, JD keyword enrichment and free-text answers.
# Everything works without it, on deterministic fallbacks.
ANTHROPIC_API_KEY=

# Optional overrides
# JOBWRAPPER_HOME=~/.jobwrapper
# JOBWRAPPER_AUTONOMY=review          # dryrun | review | auto
# JOBWRAPPER_HEADLESS=0
# JOBWRAPPER_NO_LLM=1                 # force the deterministic paths
# JOBWRAPPER_VAULT_PASSPHRASE=        # otherwise the macOS keychain or a prompt
# JOBWRAPPER_SERVER_TOKEN=            # extension token; generated on first run
