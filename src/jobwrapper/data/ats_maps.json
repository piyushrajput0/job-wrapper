{
  "version": 2,
  "note": "Per-ATS detection signatures and direct name/id -> catalog-key maps. Shared by the Python (Playwright) and JS (extension) resolvers; a hit here is the highest-confidence resolution path.",
  "ats": {
    "greenhouse": {
      "label": "Greenhouse",
      "detect": {
        "url": ["boards.greenhouse.io", "job-boards.greenhouse.io", "greenhouse.io/embed/job_app", "my.greenhouse.io"],
        "dom": ["#grnhse_app", "#grnhse_iframe", "form#application_form", "#application-form", "[id^='job_application']"],
        "text": ["Powered by Greenhouse"]
      },
      "iframe": "#grnhse_iframe",
      "name_map": {
        "first_name": "first_name",
        "job_application[first_name]": "first_name",
        "last_name": "last_name",
        "job_application[last_name]": "last_name",
        "email": "email",
        "job_application[email]": "email",
        "phone": "phone",
        "job_application[phone]": "phone",
        "job_application[location]": "location",
        "resume": "resume_file",
        "job_application[resume]": "resume_file",
        "cover_letter": "cover_letter_file",
        "job_application[cover_letter]": "cover_letter_file",
        "job_application[company]": "current_company",
        "job_application[urls][LinkedIn]": "link_linkedin",
        "job_application[urls][GitHub]": "link_github",
        "job_application[urls][Portfolio]": "link_portfolio",
        "job_application[eeoc_gender]": "eeo_gender",
        "job_application[eeoc_race]": "eeo_race",
        "job_application[eeoc_veteran_status]": "eeo_veteran",
        "job_application[eeoc_disability_status]": "eeo_disability",
        "gender": "eeo_gender",
        "race": "eeo_race",
        "veteran_status": "eeo_veteran",
        "disability_status": "eeo_disability"
      },
      "id_map": {
        "first_name": "first_name",
        "last_name": "last_name",
        "email": "email",
        "phone": "phone",
        "resume": "resume_file",
        "cover_letter": "cover_letter_file",
        "job_application_location": "location"
      },
      "file_inputs": {
        "resume_file": "input[type=file][name*='resume'], input[type=file]#resume, [data-field='resume'] input[type=file]",
        "cover_letter_file": "input[type=file][name*='cover'], input[type=file]#cover_letter"
      },
      "autocomplete_fields": ["location"],
      "submit": ["#submit_app", "input[type=submit][value*='Submit']", "button[type=submit]", "button:has-text('Submit Application')"],
      "success_text": ["thank you for applying", "your application has been submitted", "application received", "thanks for applying"],
      "duplicate_text": ["you have already applied", "already submitted an application"],
      "quirks": [
        "Location is a Google Places autocomplete: type, wait for the listbox, click a suggestion.",
        "File inputs are visually hidden behind a styled button; set files on the input directly.",
        "The whole form may live inside #grnhse_iframe on a company-hosted page.",
        "Custom questions are named question_<id> or job_application_answers_attributes_<n>_*."
      ]
    },
    "lever": {
      "label": "Lever",
      "detect": {
        "url": ["jobs.lever.co", "hire.lever.co"],
        "dom": ["form.application-form", ".application-page", "[data-qa='application-form']"],
        "text": ["Powered by Lever"]
      },
      "name_map": {
        "name": "full_name",
        "email": "email",
        "phone": "phone",
        "org": "current_company",
        "resume": "resume_file",
        "urls[LinkedIn]": "link_linkedin",
        "urls[Github]": "link_github",
        "urls[GitHub]": "link_github",
        "urls[Portfolio]": "link_portfolio",
        "urls[Twitter]": "link_twitter",
        "urls[Other]": "link_other",
        "comments": "additional_info",
        "eeo[gender]": "eeo_gender",
        "eeo[race]": "eeo_race",
        "eeo[veteran]": "eeo_veteran",
        "eeo[disability]": "eeo_disability",
        "eeo[disabilitySignature]": "eeo_name",
        "eeo[disabilitySignatureDate]": "eeo_date",
        "location": "location",
        "selectedLocation": "location"
      },
      "id_map": {},
      "file_inputs": {
        "resume_file": "input[type=file][name='resume'], input[type=file]#resume-upload-input"
      },
      "submit": ["button[type=submit]", "#btn-submit", "button:has-text('Submit application')"],
      "success_text": ["thank you for applying", "application submitted", "we have received your application"],
      "duplicate_text": ["already applied"],
      "quirks": [
        "Single 'name' field - use the profile display name, not first/last.",
        "Custom questions are cards[<cardId>][<fieldName>]; the human-readable label is the sibling text.",
        "Radio groups carry the option text in the adjacent label element."
      ]
    },
    "ashby": {
      "label": "Ashby",
      "detect": {
        "url": ["jobs.ashbyhq.com", "ashbyhq.com/embed"],
        "dom": ["._container_", "[class*='ashby-application-form']", "#ashby_embed"],
        "text": ["Powered by Ashby"]
      },
      "name_map": {
        "_systemfield_name": "full_name",
        "_systemfield_email": "email",
        "_systemfield_phone": "phone",
        "_systemfield_resume": "resume_file",
        "_systemfield_location": "location"
      },
      "id_map": {},
      "file_inputs": {
        "resume_file": "input[type=file]"
      },
      "submit": ["button[type=submit]", "button:has-text('Submit Application')"],
      "success_text": ["thank you", "application submitted", "we received your application"],
      "duplicate_text": ["already applied"],
      "quirks": [
        "React-controlled: values must be typed through real events, not assigned to .value.",
        "Fields key off _fieldEntryId; labels are the only stable human-readable anchor.",
        "File upload is a drop zone wrapping a hidden input[type=file]."
      ]
    },
    "workable": {
      "label": "Workable",
      "detect": {
        "url": ["apply.workable.com", "workable.com/j/"],
        "dom": ["[data-ui='application-form']", "[data-ui='firstname']"],
