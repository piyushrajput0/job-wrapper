        "resume": "resume_file",
        "cover_letter": "cover_letter_text",
        "address": "address_line1",
        "summary": "additional_info"
      },
      "attribute_map": {
        "data-ui": {
          "firstname": "first_name",
          "lastname": "last_name",
          "email": "email",
          "phone": "phone",
          "resume": "resume_file",
          "cover-letter": "cover_letter_text",
          "address": "address_line1",
          "linkedin-url": "link_linkedin",
          "github-url": "link_github"
        }
      },
      "file_inputs": {"resume_file": "input[type=file]"},
      "submit": ["button[type=submit]", "[data-ui='submit-application']"],
      "success_text": ["thank you for applying", "application submitted"],
      "duplicate_text": ["already applied"],
      "quirks": ["data-ui attributes are the stable hooks; name attributes vary by tenant."]
    },
