      "submit": ["[data-automation-id='bottom-navigation-next-button']", "button:has-text('Submit')"],
      "success_text": ["you have successfully submitted", "thank you for applying", "application submitted"],
      "duplicate_text": ["you have already applied", "already submitted"],
      "steps": ["Start", "My Information", "My Experience", "Application Questions", "Voluntary Disclosures", "Self Identify", "Review"],
      "quirks": [
        "Requires an account: sign in, else register (email + generated password).",
        "Every dropdown is a custom listbox: click the button, wait for [role=option], click the option.",
        "'Autofill with Resume' half-populates My Experience; verify rather than overwrite.",
        "Phone country code is a separate required listbox.",
        "Session times out after roughly 15 minutes of inactivity."
      ]
